# =================================================================
# APPNIX SAAS — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# (Do NOT commit real secrets to version control)
# =================================================================

# ----------------- APPLICATION RUNTIME -----------------
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
APP_NAME="Appnix SaaS"
FRONTEND_URL=https://www.appnix.co.in
API_BASE_URL=https://api.appnix.co.in/api/v1

# ----------------- DATABASE (AWS RDS POSTGRESQL) -----------------
# Format: postgresql://[USER]:[PASSWORD]@[RDS_ENDPOINT]:5432/[DB_NAME]?schema=public&sslmode=require
DATABASE_URL=postgresql://appnix_master:YOUR_STRONG_PASSWORD@appnix-prod-rds.xxxxxx.us-east-1.rds.amazonaws.com:5432/appnix_production?schema=public&sslmode=require

# ----------------- AUTHENTICATION & SECURITY -----------------
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_at_least_32_bytes_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_at_least_32_bytes_long
JWT_REFRESH_EXPIRATION=7d

# ----------------- AES-256-GCM CREDENTIAL ENCRYPTION VAULT -----------------
# Used to encrypt third-party credentials, tokens, and Meta WABA access keys at rest
# Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=your_aes_256_gcm_hex_encoded_key_64_characters_here

# ----------------- CLOUDFLARE R2 OBJECT STORAGE (S3 COMPATIBLE) -----------------
# Cloudflare Account ID from Cloudflare Dashboard > R2
R2_ACCOUNT_ID=
# S3 API Tokens generated under Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=appnix-saas-media
# S3 Endpoint URL (e.g. https://<ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=

# ----------------- MEDIA FILE SIZE LIMITS (MB) -----------------
MAX_IMAGE_SIZE_MB=10
MAX_DOCUMENT_SIZE_MB=25
MAX_AUDIO_SIZE_MB=16
MAX_VIDEO_SIZE_MB=64

# ----------------- META CLOUD API & EMBEDDED SIGNUP -----------------
# Meta App ID from Meta App Dashboard (developers.facebook.com)
META_APP_ID=your_meta_app_id
# Meta App Secret (Keep strictly secret on backend, NEVER expose to frontend)
META_APP_SECRET=your_meta_app_secret
# Meta Graph API Version (e.g. v21.0)
META_GRAPH_API_VERSION=v21.0
# Meta WhatsApp Embedded Signup Configuration ID (created under WhatsApp > Quickstart)
META_EMBEDDED_SIGNUP_CONFIG_ID=your_meta_embedded_signup_config_id
# Webhook verify token configured in Meta App Dashboard > Webhooks
META_WEBHOOK_VERIFY_TOKEN=your_secure_random_webhook_verify_token

# ----------------- META FACEBOOK LOGIN FOR BUSINESS & COMPLIANCE -----------------
META_OAUTH_REDIRECT_URI=https://www.appnix.co.in/channels/instagram/callback
META_DEAUTHORIZE_CALLBACK_URL=https://api.appnix.co.in/api/v1/webhooks/meta/deauthorize
META_DATA_DELETION_CALLBACK_URL=https://api.appnix.co.in/api/v1/webhooks/meta/data-deletion
META_DATA_DELETION_INSTRUCTIONS_URL=https://www.appnix.co.in/data-deletion

# ----------------- EMAIL SERVICE (BREVO / SMTP) -----------------
BREVO_API_KEY=your_brevo_smtp_api_key
MAIL_FROM_EMAIL=notifications@appnix.co.in
MAIL_FROM_NAME="Appnix Platform"

# ----------------- PAYMENT GATEWAY (CASHFREE) -----------------
# Cashfree (India UPI / Cards / NetBanking - Sandbox)
CASHFREE_APP_ID=TEST10345678abcdef0123456789cf
CASHFREE_SECRET_KEY=cfsk_ma_test_0123456789abcdef0123456789_abcdef01
CASHFREE_API_VERSION=2023-08-01
CASHFREE_MODE=sandbox

# ----------------- GOOGLE OAUTH 2.0 -----------------
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=https://api.appnix.co.in/api/v1/auth/google/callback


