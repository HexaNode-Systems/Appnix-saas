generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                 String               @id @default(uuid())
  name               String
  slug               String               @unique
  status             TenantStatus         @default(ACTIVE)
  tier               TenantTier           @default(END_CLIENT)
  path               String               @default("root")
  depth              Int                  @default(0)
  parentId           String?
  parent             Tenant?              @relation("TenantHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children           Tenant[]             @relation("TenantHierarchy")
  customDomain       String?              @unique
  primaryColor       String?              @default("#0f172a")
  logoUrl            String?
  faviconUrl         String?
  maxSubResellers    Int                  @default(0)
  maxEndClients      Int                  @default(10)
  maxUsers           Int                  @default(25)
  apiKey             String?              @unique
  webhookUrl         String?
  twoFactorEnabled   Boolean              @default(false)
  trialUsed          Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  
  domainMappings     DomainMapping[]
  crmContacts        CrmContact[]
  subscriptions      Subscription[]
  users              User[]
  campaigns          Campaign[]
  campaignAudiences  CampaignAudience[]
  channelConfigs     ChannelConfig[]
  instagramChannels        InstagramChannel[]
  instagramAutomationRules InstagramAutomationRule[]
  instagramAutomationLogs  InstagramAutomationLog[]
  metaTemplates      MetaTemplate[]
  rcsTemplates       RcsTemplate[]
  appCredentials     AppCredential[]
  folders            Folder[]
  workflows          Workflow[]
  dataStores         DataStore[]
  superFields        SuperField[]
  contactTags        ContactTag[]
  conversations      Conversation[]
  departments        Department[]
  rolePermissions    RolePermission[]
  wallet             Wallet?
  walletTransactions WalletTransaction[]
  channelTransactions ChannelTransaction[]
  supportTickets     SupportTicket[]
  activityLogs       ActivityLog[]
  invoices           Invoice[]
  notifications      Notification[]
  bots               Bot[]
  webhookEvents      WebhookEvent[]
  media              Media[]
  partnerConfig      PartnerConfig?

  @@index([path])
  @@index([parentId])
  @@index([tier, status])
  @@map("tenants")
}

enum SslStatus {
  PENDING
  ACTIVE
  FAILED
}

enum DomainVerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

model DomainMapping {
  id                 String                   @id @default(uuid())
  tenantId           String
  domain             String                   @unique
  verificationToken  String?                  @default(uuid())
  status             DomainVerificationStatus @default(PENDING)
  sslStatus          SslStatus                @default(PENDING)
  dnsRecordType      String?                  @default("CNAME")
  expectedDnsTarget  String                   @default("cname.appnix.co.in")
  verifiedAt         DateTime?
  isVerified         Boolean                  @default(false)
  sslProvisioned     Boolean                  @default(false)
  dnsExpectedValue   String?                  @default("cname.appnix.co.in")
  lastCheckedAt      DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([domain])
  @@index([tenantId])
  @@map("domain_mappings")
}

// Append-only support and platform-administration audit trail. It intentionally
// has no mutation-facing service and keeps both the actor and target tenant.
model AuditLog {
  id                String   @id @default(uuid())
  superAdminId      String
  targetWorkspaceId String
  action            String
  endpoint          String
  actorEmail        String?
  ipAddress         String?
  details           Json?
  createdAt         DateTime @default(now())

  @@index([superAdminId, createdAt])
  @@index([targetWorkspaceId, createdAt])
  @@map("audit_logs")
}

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  passwordHash        String?
  name                String?
  avatar              String?
  googleId            String?        @unique
  role                Role           @default(MEMBER)
  tenantId            String
  hashedRefreshToken  String?
  passwordResetToken  String?
  passwordResetExpiry DateTime?
  phone               String?
  secondaryEmail      String?
  city                String?
  state               String?
  country             String?        @default("india")
  zipCode             String?
  twoFactorEnabled    Boolean        @default(false)
  language            String         @default("en")
  theme               String         @default("system")
  departmentId        String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activityLogs        ActivityLog[]
  notifications       Notification[]

  @@index([tenantId])
  @@map("users")
}

model Subscription {
  id                   String             @id @default(uuid())
  tenantId             String
  planId               String             @default("pro")
  planRefId            String?
  plan                 Plan?              @relation(fields: [planRefId], references: [id])
  planName             String             @default("Professional Tier")
  price                String             @default("₹2,999/mo")
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  totalDays            Int                @default(90)
  remainingDays        Int                @default(77)
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime           @default(now())
  maxMessages          Int                @default(25000)
  usedMessages         Int                @default(0)
  maxBots              Int                @default(5)
  usedBots             Int                @default(0)
  maxTeamSeats         Int                @default(10)
  usedTeamSeats        Int                @default(1)
  isTrial              Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("subscriptions")
}

model Invoice {
  id            String   @id @default(uuid())
  tenantId      String
  invoiceNumber String   @unique
  date          DateTime @default(now())
  plan          String   @default("Professional Tier (Monthly)")
  amount        String   @default("₹2,999.00")
  status        String   @default("Paid")
  downloadUrl   String?
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("invoices")
}

model Wallet {
  id                   String   @id @default(uuid())
  tenantId             String   @unique
  balance              Float    @default(0.0)
  currency             String   @default("INR")
  minThreshold         Float    @default(500.0)
  autoRechargeEnabled  Boolean  @default(false)
  autoRechargeAmount   Float    @default(5000.0)
  defaultPaymentMethod String   @default("UPI / NetBanking")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model WalletTransaction {
  id             String   @id @default(uuid())
  tenantId       String
  transactionId  String   @unique
  date           DateTime @default(now())
  type           String   // Recharge, Usage, Subscription, Refund
  description    String
  channel        String   @default("Payment Gateway")
  amount         Float
  closingBalance Float    @default(0)
  status         String   @default("Success") // Success, Pending, Failed
  metadata       Json?
  createdAt      DateTime @default(now())
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("wallet_transactions")
}

model ChannelTransaction {
  id                    String      @id @default(uuid())
  tenantId              String
  timestamp             DateTime    @default(now())
  description           String
  campaignName          String?
  templateName          String?
  recipientPhone        String?
  recipientName         String?
  channel               String      @default("whatsapp") // whatsapp, rcs, instagram, facebook, wallet
  category              String      @default("MARKETING") // MARKETING, UTILITY, AUTHENTICATION, SERVICE, TOPUP, REFUND
  type                  String      @default("DEBIT") // DEBIT, CREDIT, REFUND
  unitCount             Int         @default(1)
  unitRate              Float       @default(0.78)
  baseRate              Float?      @default(0.72)
  platformFee           Float?      @default(0.04)
  taxAmount             Float?      @default(0.02)
  amount                Float       @default(0.78)
  closingBalance        Float       @default(0)
  deliveryStatus        String      @default("DELIVERED") // DELIVERED, SENT, READ, FAILED, COMPLETED
  isAutoRefunded        Boolean     @default(false)
  refundTxnId           String?
  failedReason          String?
  metaBillingId         String?
  wabaId                String?
  messagePayloadSnippet String?
  sentAt                DateTime?
  deliveredAt           DateTime?
  readAt                DateTime?
  createdAt             DateTime    @default(now())
  tenant                Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("channel_transactions")
}

model CrmContact {
  id               String         @id @default(uuid())
  tenantId         String
  name             String
  phone            String?
  email            String?
  tags             String[]       @default([])
  superFieldValues Json?          @default("{}")
  avatarUrl        String?
  department       String?        @default("sales")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations    Conversation[]

  @@index([tenantId])
  @@map("crm_contacts")
}

model SuperField {
  id             String   @id @default(uuid())
  tenantId       String
  key            String   // system slug e.g. "customer_tier"
  label          String   // human label e.g. "Customer Tier"
  description    String?
  dataType       String   @default("TEXT") // TEXT, TEXTAREA, DROPDOWN, MULTI_SELECT, NUMERIC, DECIMAL, AMOUNT, EMAIL, PHONE, URL, ADDRESS, DATE, DATETIME, PERIODIC_TIME
  options        Json?    @default("[]")
  defaultValue   Json?
  helperText     String?
  placeholder    String?
  currencySymbol String?  @default("₹")
  validation     Json     @default("{\"isRequired\":false}")
  placement      Json     @default("{\"contactProfile\":true,\"chatInboxLabel\":true,\"chatInboxSidebar\":true}")
  status         String   @default("ACTIVE") // ACTIVE, ARCHIVED
  usageCount     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("super_fields")
}

model ContactTag {
  id          String   @id @default(uuid())
  tenantId    String
  slug        String   // e.g. "hot-lead"
  name        String   // e.g. "Hot Lead"
  description String?
  color       String   @default("emerald") // red, amber, emerald, blue, indigo, purple, slate
  icon        String   @default("star") // star, flame, check-circle, alert-triangle, shield, bookmark, tag, heart, zap, sparkles
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("contact_tags")
}

model Conversation {
  id                String       @id @default(uuid())
  uid               String       // e.g. "CHT-948210"
  tenantId          String
  contactId         String?
  name              String
  identifier        String       // "+91 77539 83175"
  avatarUrl         String?
  channel           String       @default("whatsapp") // whatsapp, instagram, rcs, facebook
  department        String       @default("sales")
  assignedAgentId   String?
  assignedAgentName String?
  online            Boolean      @default(false)
  unreadCount       Int          @default(0)
  lastMessage       String       @default("")
  lastMessageTime   DateTime     @default(now())
  lastMessageSender String       @default("customer") // customer, agent, system, bot
  tags              Json         @default("[]")
  session           Json?        @default("{\"isActive\":true,\"remainingHours\":24}")
  isBotActive       Boolean      @default(false)
  status            String       @default("open") // open, closed, snoozed, archived
  superFields       Json?        @default("{}")
  internalNotes     Json?        @default("[]")
  remarks           Json?        @default("{\"sentiment\":\"neutral\",\"leadStage\":\"Discovery\",\"notes\":\"\"}")
  scheduledMessages Json?        @default("[]")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact           CrmContact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages          Message[]

  @@index([tenantId])
  @@index([contactId])
  @@index([status])
  @@map("conversations")
}

model Message {
  id                String       @id @default(uuid())
  conversationId    String
  tenantId          String
  sender            String       @default("customer") // customer, agent, system, bot
  senderName        String?
  senderAvatar      String?
  text              String
  timestamp         DateTime     @default(now())
  status            String       @default("delivered") // sending, sent, delivered, read, failed
  isTemplate        Boolean      @default(false)
  templateName      String?
  mediaUrl          String?
  mediaType         String?      // image, video, document, audio
  providerMessageId String?      // Meta wamid or carrier message id
  carrierAudit      Json?
  createdAt         DateTime     @default(now())
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([tenantId])
  @@index([providerMessageId])
  @@map("messages")
}

model Campaign {
  id                   String              @id @default(uuid())
  tenantId             String
  name                 String
  description          String?
  audienceId           String?
  audienceName         String?
  audienceCount        Int                 @default(0)
  audienceSnapshot     Json?
  channel              ChannelType
  metaTemplateId       String?
  metaTemplateName     String?
  metaTemplateLanguage String?
  templateVariables    Json?
  variableMappings     Json?
  status               CampaignStatus      @default(DRAFT)
  launchMode           LaunchMode          @default(IMMEDIATE)
  scheduledAt          DateTime?
  testSentAt           DateTime?
  testRecipient        String?
  testStatus           TestStatus?
  testMessageId        String?
  launchedAt           DateTime?
  completedAt          DateTime?
  errorMessage         String?
  createdBy            String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@map("campaigns")
}

model CampaignAudience {
  id           String         @id @default(uuid())
  tenantId     String
  name         String
  description  String?
  contactIds   String[]
  contactCount Int            @default(0)
  status       AudienceStatus @default(ACTIVE)
  lastUpdated  DateTime       @default(now()) @updatedAt
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("campaign_audiences")
}

model ChannelConfig {
  id              String      @id @default(uuid())
  tenantId        String
  channel         ChannelType
  isConnected     Boolean     @default(false)
  config          Json?
  connectedAt     DateTime?
  lastVerifiedAt  DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channel])
  @@index([tenantId])
  @@map("channel_configs")
}

enum InstagramChannelStatus {
  ACTIVE
  EXPIRED
  DISCONNECTED
}

enum InstagramPostScope {
  ALL_POSTS
  SPECIFIC_POST
}

enum InstagramAutomationStatus {
  SUCCESS
  FAILED
}

model InstagramChannel {
  id                  String                 @id @default(uuid())
  tenantId            String
  workspaceId         String?
  instagramBusinessId String                 @unique
  pageId              String
  username            String
  name                String?
  profilePictureUrl   String?
  accessToken         String                 // Encrypted long-lived token (AES-256-GCM)
  tokenExpiresAt      DateTime?
  status              InstagramChannelStatus @default(ACTIVE)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rules               InstagramAutomationRule[]
  logs                InstagramAutomationLog[]

  @@index([tenantId])
  @@index([instagramBusinessId])
  @@map("instagram_channels")
}

model InstagramAutomationRule {
  id                  String              @id @default(uuid())
  tenantId            String
  channelId           String
  name                String
  isActive            Boolean             @default(true)
  postScope           InstagramPostScope  @default(ALL_POSTS)
  specificMediaId     String?
  triggerKeywords     String[]            @default([])
  publicReplyTemplate String?
  privateDmTemplate   String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel             InstagramChannel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  logs                InstagramAutomationLog[]

  @@index([channelId])
  @@index([tenantId])
  @@map("instagram_automation_rules")
}

model InstagramAutomationLog {
  id                String                    @id @default(uuid())
  tenantId          String
  channelId         String
  ruleId            String?
  commentId         String
  commentText       String?
  mediaId           String?
  senderInstagramId String
  senderUsername    String?
  publicReplySent   Boolean                   @default(false)
  privateDmSent     Boolean                   @default(false)
  status            InstagramAutomationStatus @default(SUCCESS)
  error             String?
  createdAt         DateTime                  @default(now())

  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel           InstagramChannel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  rule              InstagramAutomationRule?  @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([channelId])
  @@index([ruleId])
  @@index([tenantId])
  @@map("instagram_automation_logs")
}

model MetaTemplate {
  id             String           @id @default(uuid())
  tenantId       String
  metaTemplateId String           @unique
  name           String
  category       TemplateCategory
  language       String
  status         TemplateStatus
  components     Json
  preview        String?
  lastSyncedAt   DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("meta_templates")
}

model RcsTemplate {
  id                String            @id @default(uuid())
  tenantId          String
  channelId         String?
  agentId           String            @default("agent_appnix_rcs")
  agentName         String            @default("Appnix RCS Verified")
  name              String
  category          String            @default("PROMOTIONAL") // PROMOTIONAL, TRANSACTIONAL, OTP
  messageType       String            @default("TEXT") // TEXT, RICH_CARD, CAROUSEL
  textBody          String?
  standaloneActions Json?             @default("[]")
  card              Json?
  cards             Json?             @default("[]")
  variables         Json?             @default("[]")
  variableMappings  Json?             @default("{}")
  status            String            @default("DRAFT") // DRAFT, PENDING, APPROVED, REJECTED, DISABLED
  rcsTemplateId     String?
  carrierApprovals  Json?             @default("[]")
  rejectionReason   String?
  rejectionDetails  Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  submittedAt       DateTime?
  approvedAt        DateTime?
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("rcs_templates")
}

model Folder {
  id        String     @id @default(uuid())
  tenantId  String
  name      String
  workflows Workflow[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("folders")
}

model Workflow {
  id          String      @id @default(uuid())
  tenantId    String
  title       String
  status      Boolean     @default(true)
  folderId    String?
  folder      Folder?     @relation(fields: [folderId], references: [id], onDelete: SetNull)
  triggerType TriggerType @default(INBOUND_MESSAGE)
  tags        String[]    @default([])
  nodes       Json        @default("[]")
  edges       Json        @default("[]")
  isLocked    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([folderId])
  @@map("workflows")
}

model WorkflowLicense {
  id            String    @id @default(uuid())
  key           String    @unique
  workflowId    String?
  workflowTitle String?
  redeemedBy    String?
  isRedeemed    Boolean   @default(false)
  redeemedAt    DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("workflow_licenses")
}

model DataStore {
  id          String            @id @default(uuid())
  tenantId    String
  name        String
  slug        String
  description String?
  keyType     String            @default("STRING")
  ttlSeconds  Int?              // Optional time-to-live for transient data
  recordLimit Int               @default(10000)
  records     DataStoreRecord[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("data_stores")
}

model DataStoreRecord {
  id          String    @id @default(uuid())
  dataStoreId String
  dataStore   DataStore @relation(fields: [dataStoreId], references: [id], onDelete: Cascade)
  key         String    // Unique lookup key per store (e.g. phone or userId)
  value       Json      // Structured JSON record payload
  expiresAt   DateTime? // Computed from TTL
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([dataStoreId, key])
  @@index([dataStoreId, key])
  @@index([expiresAt])
  @@map("data_store_records")
}

model WorkflowTemplate {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  description  String
  category     String   // E_COMMERCE, SUPPORT, MARKETING, LEAD_GEN, UTILITY
  channels     String[] // WHATSAPP, RCS, FACEBOOK, INSTAGRAM
  apps         String[] // SHOPIFY, WEBHOOK, GOOGLE_SHEETS, AI_AGENT
  nodes        Json     @default("[]")
  edges        Json     @default("[]")
  isPremium    Boolean  @default(false)
  installCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("workflow_templates")
}

model AppCredential {
  id                   String    @id @default(uuid())
  tenantId             String
  appName              String    // SHOPIFY, OPENAI, CASHFREE, CUSTOM_WEBHOOK, HUBSPOT, etc.
  accountName          String    // User label: e.g., "Production Shopify"
  authType             AuthType
  credentials          Json      // Encrypted credentials payload (API keys, secret tokens)
  isActive             Boolean   @default(true)
  lastTestedAt         DateTime?
  isHealthy            Boolean   @default(true)
  linkedWorkflowsCount Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("app_credentials")
}

model Department {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  status      Json     @default("{\"label\":\"Active\",\"tone\":\"green\"}")
  tag         Json     @default("{\"label\":\"General\",\"tone\":\"green\"}")
  description String   @default("")
  icon        String   @default("Building2")
  avatars     Json?    @default("[]")
  extraCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("departments")
}

model RolePermission {
  id          String   @id @default(uuid())
  tenantId    String
  roleId      String   // e.g. "dept-manager", "agent", "team-lead"
  roleName    String   // e.g. "Department Manager"
  description String   @default("")
  badgeTone   String   @default("blue")
  userCount   Int      @default(0)
  permissions Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleId])
  @@index([tenantId])
  @@map("role_permissions")
}

model SupportTicket {
  id            String   @id @default(uuid())
  tenantId      String
  ticketNumber  String   @unique // e.g. "SUP-10245"
  subject       String
  category      String   @default("Technical Support")
  priority      String   @default("Medium") // Low, Medium, High, Urgent
  status        String   @default("Open") // Open, In Progress, Waiting for Customer, Resolved, Closed
  description   String
  assignedAgent Json?
  attachments   String[] @default([])
  replies       Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("support_tickets")
}

model ActivityLog {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?
  user      String   @default("System")
  action    String
  module    String
  ip        String   @default("127.0.0.1")
  status    String   @default("Success") // Success, Warning, Failed
  metadata  Json?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userModel User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@map("activity_logs")
}

model Notification {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String?
  title       String
  description String
  type        String   @default("info") // info, warning, success, error
  isRead      Boolean  @default(false)
  link        String?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userModel   User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@map("notifications")
}

model Bot {
  id                 String   @id @default(uuid())
  tenantId           String
  name               String
  description        String?
  triggerType        String   @default("INBOUND_MESSAGE")
  status             String   @default("ACTIVE") // ACTIVE, DRAFT, PAUSED
  nodes              Json     @default("[]")
  edges              Json     @default("[]")
  currentVersion     Int      @default(1)
  interactionsCount  Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("bots")
}

model WebhookEvent {
  id          String    @id @default(uuid())
  tenantId    String?
  provider    String    // META, CASHFREE, SHOPIFY, RCS
  eventId     String    @unique
  eventType   String
  payload     Json
  status      String    @default("PROCESSED") // RECEIVED, PROCESSED, FAILED, IGNORED
  error       String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([provider, eventId])
  @@index([tenantId])
  @@map("webhook_events")
}

model Media {
  id           String      @id @default(uuid())
  tenantId     String
  uploadedBy   String?
  objectKey    String      @unique
  bucket       String
  originalName String
  mimeType     String
  size         Int
  category     String      // IMAGE, DOCUMENT, AUDIO, VIDEO, OTHER
  status       String      @default("PENDING") // PENDING, READY, FAILED, DELETED
  provider     String      @default("CLOUDFLARE_R2")
  isPrivate    Boolean     @default(true)
  metadata     Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([category])
  @@index([status])
  @@map("media")
}

enum AuthType {
  API_KEY
  BEARER_TOKEN
  OAUTH2
  BASIC_AUTH
}

enum TriggerType {
  INBOUND_MESSAGE
  WEBHOOK_EVENT
  SCHEDULED_CRON
  FORM_SUBMISSION
}

enum CampaignStatus {
  DRAFT
  READY_FOR_TEST
  TEST_SENT
  SCHEDULED
  LAUNCHING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum LaunchMode {
  IMMEDIATE
  SCHEDULED
}

enum TestStatus {
  PENDING
  SENT
  FAILED
}

enum ChannelType {
  WHATSAPP
  INSTAGRAM
  RCS
  FACEBOOK
}

enum AudienceStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum TemplateStatus {
  APPROVED
  PENDING
  REJECTED
  PAUSED
}

enum Role {
  SUPER_ADMIN
  APP_ADMIN
  RESELLER_ADMIN
  TENANT_ADMIN
  CLIENT_USER
  MEMBER
}

enum TenantTier {
  PLATFORM_ROOT
  PRIMARY_RESELLER
  SUB_RESELLER
  END_CLIENT
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  UPGRADED
}

enum PaymentOrderStatus {
  PENDING
  SUCCESS
  FAILED
  USER_DROPPED
}

model Plan {
  id                   String         @id @default(uuid())
  name                 String
  slug                 String         @unique
  description          String?
  price                Decimal        @db.Decimal(10, 2)
  monthlyPrice         Float?
  yearlyPrice          Float?
  currency             String         @default("INR")
  billingCycle         String         @default("monthly")
  monthlyMessages      Int            @default(2000)
  botflows             Int            @default(1)
  teamSeats            Int            @default(2)
  maxUsers             Int?           @default(2)
  maxContacts          Int?           @default(500)
  maxCampaigns         Int?           @default(5)
  maxBots              Int?           @default(1)
  maxMessages          Int?           @default(2000)
  apiQuota             Int?
  storageQuotaMb       Int?
  supportLevel         String?
  trialDays            Int?           @default(0)
  isPopular            Boolean?       @default(false)
  customDomain         Boolean?       @default(false)
  sso                  Boolean?       @default(false)
  prioritySupport      Boolean?       @default(false)
  status               String?        @default("ACTIVE")
  features             Json           @default("[]")
  razorpayAnnualPlanId String?
  razorpayMonthlyPlanId String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  subscriptions        Subscription[]
  paymentOrders        PaymentOrder[]

  @@map("plans")
}

model PaymentOrder {
  id               String             @id @default(uuid())
  orderId          String             @unique
  workspaceId      String
  planId           String?
  plan             Plan?              @relation(fields: [planId], references: [id])
  amount           Decimal            @db.Decimal(10, 2)
  currency         String             @default("INR")
  paymentSessionId String?
  status           PaymentOrderStatus @default(PENDING)
  cfPaymentId      String?
  paymentMethod    String?
  rawWebhookData   Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([workspaceId])
  @@map("payment_orders")
}

model WholesalePlan {
  id             String          @id @default(uuid())
  name           String
  slug           String          @unique
  description    String?
  setupFee       Decimal         @default(0) @db.Decimal(10, 2)
  perClientPrice Decimal         @default(499) @db.Decimal(10, 2)
  currency       String          @default("INR")
  billingCycle   String          @default("monthly")
  maxClients     Int             @default(50)
  featureAccess  Json            @default("[]")
  status         String          @default("ACTIVE")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  partnerConfigs PartnerConfig[]

  @@map("wholesale_plans")
}

model PartnerConfig {
  id              String         @id @default(uuid())
  tenantId        String         @unique
  wholesalePlanId String?
  setupFee        Decimal        @default(0) @db.Decimal(10, 2)
  setupFeePaid    Boolean        @default(true)
  perClientRate   Decimal        @default(499) @db.Decimal(10, 2)
  clientLimit     Int            @default(20)
  featureAccess   Json           @default("[]")
  customDomain    String?
  trialEnabled    Boolean        @default(false)
  trialDays       Int            @default(7)
  trialMaxUsers   Int            @default(5)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wholesalePlan   WholesalePlan? @relation(fields: [wholesalePlanId], references: [id], onDelete: SetNull)

  @@index([wholesalePlanId])
  @@map("partner_configs")
}
